# Copie para .env (só na VPS ou na sua máquina; nunca commite). Permissão 600.
# Variáveis por serviço. Valores propositalmente vazios.

# ---------- Geral ----------
APP_ENV=                      # dev | prod
SITE_URL=                     # https://alpherion.com.br
APP_URL=                      # https://app.alpherion.com.br
API_URL=                      # http://api:8000 (rede interna) | https://api.alpherion.com.br

# ---------- Postgres (um usuário por serviço; §7.6) ----------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_SUPERUSER_PASSWORD=  # só para init e migrações manuais
PG_WEB_USER=                  # dono do schema app
PG_WEB_PASSWORD=
PG_API_USER=                  # leitura no schema market
PG_API_PASSWORD=
PG_DATA_USER=                 # escrita no schema market (worker)
PG_DATA_PASSWORD=

# ---------- Redis ----------
REDIS_PASSWORD=               # usada pelo compose (--requirepass); a mesma senha vai na REDIS_URL
REDIS_URL=                    # redis://:senha@redis:6379/0

# ---------- web (Next.js) ----------
DATABASE_URL=                 # postgres://PG_WEB_USER:...@host/db?options=-c%20search_path%3Dapp
BETTER_AUTH_SECRET=           # 256 bits, base64
BETTER_AUTH_URL=              # = APP_URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
API_SERVICE_TOKEN_WEB=        # token de serviço do cliente "web" na API (escopos analyses:write, imports:write, market:read, quotes:read)
APP_ENCRYPTION_KEY_V1=        # AES-256-GCM, base64; key_version=1
APP_ENCRYPTION_KEY_VERSION=   # 1
REVALIDATE_TOKEN=             # usado pelo job revalidate_pages
LISTMONK_URL=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
LISTMONK_LIST_ID=             # id da lista "Leitura de Mercado" (infra/scripts/listmonk-setup.py imprime)
LISTMONK_OPTIN_TEMPLATE_ID=   # template transacional de confirmação (idem)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_TRANSACTIONAL=     # no-reply@alpherion.com.br
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=             # https://stats.alpherion.com.br/script.js
ANALYSES_PER_DAY_FREE=        # 3
MAX_POSITIONS_FREE=           # 100
GLITCHTIP_DSN_WEB=

# ---------- api (FastAPI) ----------
MARKET_DATABASE_URL=          # postgres://PG_API_USER:...@host/db?options=-c%20search_path%3Dmarket
API_SERVICE_TOKENS=           # JSON: {"web":{"token":"...","scopes":["analyses:write","imports:write","market:read","quotes:read"]}}
MARKET_B3_PRICES_ENABLED=     # false até a licença da B3 estar registrada em docs/fontes-de-dados.md (ADR-017)
MARKET_CRYPTO_ENABLED=        # false até a fonte de cripto licenciada (ADR-017)
CORS_ORIGINS=                 # https://app.alpherion.com.br
ANTHROPIC_API_KEY=
LLM_MODEL=                    # id do modelo escolhido ao implementar (§3.4)
LLM_TIMEOUT_S=                # 15
ANALYSIS_TIMEOUT_S=           # 30
LLM_DAILY_BUDGET_USD=
ENGINE_VERSION=
PROMPT_VERSION=
GLITCHTIP_DSN_API=

# ---------- data (worker) ----------
DATA_DATABASE_URL=            # postgres://PG_DATA_USER:...@host/db?options=-c%20search_path%3Dmarket
COINGECKO_API_KEY=            # Demo só em dev; produção exige plano pago (ADR-017)
DATA_DOWNLOAD_DIR=            # diretório temporário com limite de tamanho
DATA_MAX_DOWNLOAD_MB=
TELEGRAM_BOT_TOKEN=           # alertas
TELEGRAM_ALERT_CHAT_ID=

# ---------- infra ----------
ROOT_DOMAIN=                  # alpherion.com.br (usado pelo compose de produção)
GHCR_OWNER=                   # dono das imagens no GHCR (ex.: bryanmzauza)
IMAGE_TAG=                    # tag em produção; o deploy.sh exporta automaticamente
MARKET_TABLESPACE_PATH=       # /srv/alpherion/market (volume separado do schema market, §7.6)
BACKUP_RETENTION_DAYS=        # 30
LISTMONK_DB_PASSWORD=         # banco próprio do Listmonk no mesmo Postgres
UMAMI_DB_PASSWORD=            # banco próprio do Umami
CLOUDFLARE_ORIGIN_CERT_PATH=
CLOUDFLARE_ORIGIN_KEY_PATH=
BACKUP_AGE_PUBLIC_KEY=        # a chave privada fica FORA da VPS
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
UMAMI_APP_SECRET=
LISTMONK_ADMIN_USER=
LISTMONK_ADMIN_PASSWORD=
