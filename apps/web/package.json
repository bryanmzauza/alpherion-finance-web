{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lighthouse": "lhci autorun",
    "build:migrator": "esbuild scripts/migrate.mjs --bundle --platform=node --format=esm --target=node22 --outfile=dist/migrate.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/env": "^16.3.6",
    "@next/mdx": "^16.3.6",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "next": "16.3.6",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.1"
  }
}
